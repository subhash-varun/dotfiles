
{
"layer": "top",
"position": "top",
"height": 32,
"spacing": 0,
"margin-top": 6,
"margin-left": 12,
"margin-right": 12,

"modules-left": ["sway/workspaces"],
"modules-center": ["clock"],
"modules-right": ["battery", "backlight", "pulseaudio", "tray"],

"sway/workspaces": {
"disable-scroll": true,
"all-outputs": true,
"persistent-workspaces": {
"*": [1, 2, 3]
},
"format": "{name} {icon}",
"format-icons": {
"focused": "●",
"default": "○",
"urgent": "◉"
},
"on-click": "activate"
},

"clock": {
"interval": 1,
"format": "{:%a %d %b  %H:%M}",
"tooltip": false
},

"battery": {
"states": {
"warning": 25,
"critical": 15
},
"format": "  {capacity}%",
"format-charging": "  {capacity}%",
"format-plugged": "  {capacity}%"
},

"backlight": {
"format": "󰃠  {percent}%",
"tooltip": false
},

"pulseaudio": {
"format": "  {volume}%",
"format-muted": "  mute",
"scroll-step": 5,
"on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
},

"tray": {
"spacing": 8,
"icon-size": 13
}
}
